# Supabase (igual que CamilaCordoba)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Storage: bucket público "media-files" (crear en Dashboard → Storage)
# Ejecutar también prisma/supabase/004_storage_media.sql para políticas RLS

# Prisma → Postgres de Supabase (datos del portafolio)
# Preferir Transaction pooler (puerto 6543) para la app — más conexiones y compatible con Prisma:
# DATABASE_URL=postgresql://postgres.your-project:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
#
# Session pooler (puerto 5432) tiene límite bajo de clientes; úsalo solo si 6543 no aplica.
# DATABASE_URL=postgresql://postgres.your-project:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
#
# Opcional: máximo de conexiones del pool local (default 3)
# DATABASE_POOL_MAX=3
DATABASE_URL=postgresql://postgres.your-project:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Resend (notificaciones por correo)
# API key: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx
# Remitente verificado en Resend (incluye nombre visible)
RESEND_FROM_EMAIL=CapturasTamara <notificaciones@capturastamara.com>
# Buzón donde llegan las respuestas del cliente
RESEND_REPLY_TO=contacto@capturastamara.com
